{
  "name": "modus_zero_landing",
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "astro": "astro",
    "check": "astro check",
    "lint": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/react": "^7.1.4",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.1.2",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.55",
    "@lucide/svelte": "^1.70.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.4.7",
    "astro-compress": "^2.4.3",
    "astro-icon": "^1.2.0",
    "astro-robots-txt": "^1.0.0",
    "astro-seo": "^1.2.0",
    "astro-seo-schema": "^7.0.1",
    "gsap": "^3.15.1",
    "motion": "^12.23.26",
    "octokit": "^5.0.5",
    "ogl": "^1.0.11",
    "oxc-transform-react": "^0.145.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-tweet": "^3.3.0",
    "schema-dts": "^1.1.5",
    "svelte": "^5.57.3",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@astrojs/check": "^0.9.12",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3"
  },
  "prettier": {
    "tabWidth": 4,
    "printWidth": 120,
    "singleQuote": true,
    "semi": true,
    "bracketSpacing": true,
    "endOfLine": "auto",
    "plugins": [
      "prettier-plugin-astro",
      "prettier-plugin-svelte",
      "prettier-plugin-tailwindcss"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      },
      {
        "files": "*.svelte",
        "options": {
          "parser": "svelte"
        }
      }
    ]
  }
}
