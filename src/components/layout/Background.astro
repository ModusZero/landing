---
/**
 * Fondo animado de anillos concéntricos dibujado en un <canvas> 2D.
 *
 * Reemplaza al anterior (Vanta + three.js desde CDN + filtro blur de pantalla completa), que era la
 * principal causa de lentitud. Esta versión:
 *  - no descarga librerías (~0 KB extra) y no usa WebGL;
 *  - limita la tasa de cuadros y la densidad de píxeles;
 *  - se detiene al ocultar la pestaña, al hacer scroll y con `prefers-reduced-motion`;
 *  - se atenúa con opacidad (barato para el compositor) en vez de un blur.
 */
---

<div
    id="rings-bg"
    aria-hidden="true"
    class="pointer-events-none fixed inset-0 -z-10 overflow-hidden transition-opacity duration-700"
>
    <canvas id="rings-canvas" class="block h-full w-full"></canvas>
</div>

<script>
    const root = document.getElementById('rings-bg') as HTMLDivElement | null;
    const canvas = document.getElementById('rings-canvas') as HTMLCanvasElement | null;
    const ctx = canvas?.getContext('2d', { alpha: true });

    if (root && canvas && ctx) {
        const RING_COUNT = 11;
        const FRAME_MS = 1000 / 30;
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

        let width = 0;
        let height = 0;
        let rgb = '82, 39, 255';
        let pointer = { x: 0.5, y: 0.5 };
        let center = { x: 0.5, y: 0.5 };
        let frame = 0;
        let last = 0;
        let scrolled = false;

        const readTheme = () => {
            const dark = document.documentElement.classList.contains('dark');
            rgb = dark ? '120, 92, 255' : '70, 150, 235';
        };

        const resize = () => {
            const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
            width = canvas.clientWidth;
            height = canvas.clientHeight;
            canvas.width = Math.round(width * dpr);
            canvas.height = Math.round(height * dpr);
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            draw(performance.now());
        };

        const draw = (time: number) => {
            ctx.clearRect(0, 0, width, height);

            const reach = Math.hypot(width, height) * 0.62;
            const cx = center.x * width;
            const cy = (center.y * 0.6 + 0.2) * height;

            for (let i = 0; i < RING_COUNT; i++) {
                // Cada anillo crece despacio y se desvanece al alejarse del centro.
                const phase = (i / RING_COUNT + time / 38000) % 1;
                const radius = phase * reach;
                const wobble = Math.sin(time / 2600 + i * 1.3) * 6;
                const alpha = (1 - phase) * 0.34 * Math.min(1, phase * 6);

                ctx.beginPath();
                ctx.arc(cx + wobble, cy - wobble * 0.5, radius, 0, Math.PI * 2);
                ctx.lineWidth = 1.4 + (1 - phase) * 2.4;
                ctx.strokeStyle = `rgba(${rgb}, ${alpha.toFixed(3)})`;
                ctx.stroke();
            }
        };

        const loop = (time: number) => {
            frame = requestAnimationFrame(loop);
            if (time - last < FRAME_MS) return;
            last = time;

            // La posición del puntero se suaviza para un movimiento sin saltos.
            center.x += (pointer.x - center.x) * 0.04;
            center.y += (pointer.y - center.y) * 0.04;
            draw(time);
        };

        const start = () => {
            if (frame || reduced.matches || scrolled || document.hidden) return;
            frame = requestAnimationFrame(loop);
        };

        const stop = () => {
            cancelAnimationFrame(frame);
            frame = 0;
        };

        const sync = () => {
            stop();
            readTheme();
            draw(performance.now());
            start();
        };

        window.addEventListener('resize', resize, { passive: true });
        window.addEventListener(
            'pointermove',
            (event) => {
                pointer = { x: event.clientX / window.innerWidth, y: event.clientY / window.innerHeight };
            },
            { passive: true },
        );
        window.addEventListener(
            'scroll',
            () => {
                const next = window.scrollY > 24;
                if (next === scrolled) return;
                scrolled = next;
                // Al hacer scroll el fondo se atenúa y se congela: no compite con el contenido.
                root.style.opacity = scrolled ? '0.28' : '1';
                scrolled ? stop() : start();
            },
            { passive: true },
        );
        document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
        reduced.addEventListener('change', sync);
        new MutationObserver(sync).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

        readTheme();
        resize();
        start();
    }
</script>
