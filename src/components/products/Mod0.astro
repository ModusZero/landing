---
import { MOD0_FULL_CONFIG } from '@/config/products/mod0/config';
import { getI18nPath, getLangFromUrl, useTranslations } from '@/i18n/utils';
import '@/styles/ide-demo.css';

import RotatingText from '@/components/islands/RotatingText';
import IdeTour from '@/components/ide/IdeTour.svelte';

import Features from '@/components/common/Features.astro';
import HowItWorks from '@/components/common/HowItWorks.astro';
// import Pricing from '@/components/common/Pricing.astro';
import FAQ from '@/components/common/FAQ.astro';
import FutureNews from '@/components/common/FutureNews.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const REPO_URL = 'https://github.com/moduszero/mod0';
const shot = (name: string) => `${base}/images/ide/${lang}/${name}.webp`;

const rotatingWords = ['intelligent', 'agentic', 'autonomic', 'precise', 'modern'].map((word) =>
    t(`products.mod0.rotating_words.${word}`),
);

const tabIds = ['sessions', 'graph', 'project', 'review', 'kanban'] as const;
const tabs = tabIds.map((id) => ({
    id,
    title: t(`products.mod0.tour.tabs.${id}.title`),
    description: t(`products.mod0.tour.tabs.${id}.description`),
    bullets: [1, 2, 3].map((n) => t(`products.mod0.tour.tabs.${id}.b${n}`)),
}));

const labelKeys = [
    'search',
    'sessions',
    'waitingShort',
    'all',
    'attention',
    'working',
    'idle',
    'waiting',
    'turn',
    'steps',
    'prompt',
    'depth',
    'modules',
    'links',
    'reviewed',
    'approve',
    'commit',
    'commitMessage',
    'backlog',
    'doing',
    'reviewCol',
    'done',
    'start',
    'add',
    'files',
    'idleLabel',
];
const labels = Object.fromEntries(labelKeys.map((key) => [key, t(`products.mod0.tour.labels.${key}`)]));

const observerSteps = ['cli', 'hooks', 'ui'] as const;
const gallery = ['sessions', 'graph', 'project', 'review', 'kanban'] as const;
const galleryFile: Record<(typeof gallery)[number], string> = {
    sessions: 'sessions',
    graph: 'thinking-graph',
    project: 'files-graph',
    review: 'review',
    kanban: 'kanban',
};

const hooksExample = `{
  "hooks": {
    "PreToolUse": [{ "hooks": [{ "type": "http", "url": "http://127.0.0.1:51423/hook/<session>/<token>" }] }],
    "Notification": [{ "hooks": [{ "type": "http", "url": "…" }] }],
    "Stop": [{ "hooks": [{ "type": "http", "url": "…" }] }]
  }
}`;
---

<div class="bg-app text-main relative w-full overflow-x-hidden">
    <!-- HERO -->
    <section class="relative overflow-hidden bg-transparent px-4 pt-32 pb-16 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-7xl">
            <div class="relative z-10 mx-auto max-w-4xl text-center">
                <div
                    class="bg-accent/10 border-accent/20 text-accent mb-6 inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-bold tracking-widest uppercase"
                >
                    <span class="relative flex h-2 w-2">
                        <span class="bg-accent absolute inline-flex h-full w-full animate-ping rounded-full opacity-75"
                        ></span>
                        <span class="bg-accent relative inline-flex h-2 w-2 rounded-full"></span>
                    </span>
                    {t('products.mod0.name')}
                    <RotatingText
                        client:visible
                        texts={rotatingWords}
                        mainClassName="ml-1 text-accent"
                        staggerDuration={0.02}
                        rotationInterval={3000}
                        transition={{ type: 'spring', damping: 25, stiffness: 300 }}
                    />
                </div>

                <h1 class="text-glow hero-title mb-6 text-5xl leading-[1.1] font-black tracking-tighter lg:text-7xl">
                    {t('products.mod0.tagline')}
                </h1>

                <p
                    class="text-glow mx-auto mb-10 max-w-3xl text-lg leading-relaxed opacity-80 drop-shadow-sm md:text-xl"
                >
                    {t('products.mod0.description')}
                </p>

                <div class="flex flex-col justify-center gap-4 sm:flex-row">
                    <a
                        href={getI18nPath(base + '/', lang, 'resources/releases')}
                        aria-label={t('products.mod0.get_started')}
                        class="cursor-target bg-accent inline-flex justify-center rounded-xl px-8 py-4 font-bold text-white shadow-[0_10px_30px_rgba(14,165,233,0.3)] transition-transform hover:-translate-y-1 active:scale-95"
                    >
                        {t('products.mod0.get_started')}
                    </a>
                    <a
                        href={getI18nPath(base + '/', lang, 'resources/docs')}
                        aria-label={t('products.mod0.learn_more')}
                        class="cursor-target inline-flex items-center justify-center rounded-xl border px-8 py-4 text-center font-bold transition-colors hover:bg-(--text-main)/10 active:scale-95"
                        style="border-color: var(--border-main); color: var(--text-main);"
                    >
                        {t('products.mod0.learn_more')}
                    </a>
                </div>
            </div>

            <!-- Captura real: se carga primero porque es lo más visible de la página. -->
            <div class="relative mx-auto mt-16 max-w-6xl">
                <div class="bg-accent/15 absolute inset-x-[8%] top-[10%] bottom-0 -z-10 rounded-full blur-[90px]"></div>
                <div
                    class="border-border-main overflow-hidden rounded-2xl border shadow-[0_40px_90px_-20px_rgba(0,0,0,0.55)]"
                >
                    <img
                        src={shot('sessions')}
                        alt={t('products.mod0.gallery.items.sessions')}
                        width="2400"
                        height="1500"
                        fetchpriority="high"
                        decoding="async"
                        class="block h-auto w-full"
                    />
                </div>
            </div>
        </div>
    </section>

    <!-- FILOSOFÍA -->
    <section class="px-4 py-16 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
            <span class="text-accent text-xs font-bold tracking-widest uppercase"
                >{t('products.mod0.philosophy.tag')}</span
            >
            <h2 class="mt-4 mb-5 text-3xl font-black tracking-tighter md:text-5xl">
                {t('products.mod0.philosophy.title')}
            </h2>
            <p class="text-lg leading-relaxed opacity-75">{t('products.mod0.philosophy.text')}</p>
        </div>
    </section>

    <!-- RECORRIDO INTERACTIVO -->
    <section class="px-4 py-16 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-7xl">
            <div class="mx-auto mb-14 max-w-3xl text-center">
                <h2 class="mb-4 text-3xl font-black tracking-tighter md:text-5xl">{t('products.mod0.tour.title')}</h2>
                <p class="text-lg opacity-70">{t('products.mod0.tour.subtitle')}</p>
            </div>
            <IdeTour client:visible tabs={tabs} labels={labels} lang={lang as 'es' | 'en'} />
        </div>
    </section>

    <!-- OBSERVACIÓN SIN TOKENS -->
    <section class="px-4 py-20 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-7xl">
            <div class="mx-auto mb-14 max-w-3xl text-center">
                <h2 class="mb-4 text-3xl font-black tracking-tighter md:text-5xl">
                    {t('products.mod0.observer.title')}
                </h2>
                <p class="text-lg opacity-70">{t('products.mod0.observer.subtitle')}</p>
            </div>

            <div class="mb-8 grid gap-5 md:grid-cols-3">
                {
                    observerSteps.map((step, index) => (
                        <div class="border-border-main relative rounded-2xl border bg-white/3 p-6">
                            <span class="text-accent font-mono text-xs font-bold">0{index + 1}</span>
                            <h3 class="mt-2 mb-2 text-xl font-bold">
                                {t(`products.mod0.observer.steps.${step}.title`)}
                            </h3>
                            <p class="text-sm leading-relaxed opacity-70">
                                {t(`products.mod0.observer.steps.${step}.description`)}
                            </p>
                        </div>
                    ))
                }
            </div>

            <pre
                class="border-border-main overflow-x-auto rounded-2xl border bg-black/40 p-5 font-mono text-xs text-white/80 md:text-sm"><code>{hooksExample}</code></pre>
        </div>
    </section>

    <Features featuresConfig={MOD0_FULL_CONFIG.features} />
    <HowItWorks howItWorksConfig={MOD0_FULL_CONFIG.howItWorks} />

    <!-- GALERÍA -->
    <section class="px-4 py-20 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-7xl">
            <div class="mx-auto mb-14 max-w-3xl text-center">
                <h2 class="mb-4 text-3xl font-black tracking-tighter md:text-5xl">
                    {t('products.mod0.gallery.title')}
                </h2>
                <p class="text-lg opacity-70">{t('products.mod0.gallery.subtitle')}</p>
            </div>

            <div class="grid gap-6 md:grid-cols-2">
                {
                    gallery.map((item, index) => (
                        <figure class={index === 0 ? 'md:col-span-2' : ''}>
                            <a
                                href={shot(galleryFile[item])}
                                target="_blank"
                                rel="noopener"
                                class="cursor-target border-border-main block overflow-hidden rounded-2xl border transition-transform hover:-translate-y-1"
                            >
                                <img
                                    src={shot(galleryFile[item])}
                                    alt={t(`products.mod0.gallery.items.${item}`)}
                                    width="2400"
                                    height="1500"
                                    loading="lazy"
                                    decoding="async"
                                    class="block h-auto w-full"
                                />
                            </a>
                            <figcaption class="mt-3 text-center text-sm opacity-60">
                                {t(`products.mod0.gallery.items.${item}`)}
                            </figcaption>
                        </figure>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- COMPILAR -->
    <section class="px-4 py-20 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
            <h2 class="mb-4 text-3xl font-black tracking-tighter md:text-5xl">{t('products.mod0.build.title')}</h2>
            <p class="mb-8 text-lg opacity-70">{t('products.mod0.build.subtitle')}</p>
            <pre
                class="border-border-main overflow-x-auto rounded-2xl border bg-black/40 p-6 text-left font-mono text-sm text-white/85"><code><span class="text-white/40">$</span> git clone {REPO_URL}.git
<span class="text-white/40">$</span> cd mod0 && npm install
<span class="text-white/40">$</span> npm run tauri dev</code></pre>
            <p class="mt-6 text-sm opacity-60">{t('products.mod0.build.note')}</p>
            <a
                href={REPO_URL}
                target="_blank"
                rel="noopener"
                class="cursor-target mt-6 inline-flex rounded-xl border px-6 py-3 font-bold transition-colors hover:bg-(--text-main)/10"
                style="border-color: var(--border-main);"
            >
                GitHub →
            </a>
        </div>
    </section>

    <FAQ faqConfig={MOD0_FULL_CONFIG.faq} />
    <FutureNews futureNewsConfig={MOD0_FULL_CONFIG.news} />
</div>

<style>
    .hero-title {
        color: var(--text-main);
        text-shadow: 0 4px 24px rgba(255, 255, 255, 0.4);
    }

    :global(.dark) .hero-title {
        text-shadow: 0 4px 32px rgba(0, 0, 0, 0.8);
    }
</style>
